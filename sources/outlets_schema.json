{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Outlet registry",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "country",
      "language",
      "feeds",
      "tier",
      "active"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z]{2,3}_[a-z0-9_]+$",
        "description": "Stable identifier. Lowercase country prefix, underscore, slug."
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "country": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "description": "ISO 3166-1 alpha-3"
      },
      "language": {
        "type": "string",
        "pattern": "^[a-z]{2,3}$",
        "description": "ISO 639-1 where one exists, otherwise ISO 639-3"
      },
      "feeds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^https?://"
        }
      },
      "tier": {
        "type": "string",
        "enum": [
          "national_daily",
          "agency",
          "broadcaster",
          "business",
          "regional",
          "aggregator"
        ]
      },
      "notes": {
        "type": "string"
      },
      "active": {
        "type": "boolean"
      },
      "inactive_reason": {
        "type": "string"
      },
      "inactive_since": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "audience_rank": {
        "type": "integer",
        "minimum": 1,
        "description": "Rank of the outlet by audience within its country, 1 = largest. Set from a readership source; unset means unknown. The share of all published items metric uses the 30 best ranked outlets of a country when ranks exist, otherwise every active outlet."
      }
    }
  }
}