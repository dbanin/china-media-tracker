{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State issuers of paid releases (pipeline/state_issuers.py)",
  "type": "object",
  "required": ["version", "decided_on", "places", "issuers"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "decided_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "places": {
      "type": "object",
      "required": ["provinces", "cities"],
      "additionalProperties": false,
      "properties": {
        "provinces": {"type": "array", "minItems": 1, "uniqueItems": true,
                      "items": {"type": "string", "pattern": "^[A-Z][A-Za-z' ]+$"}},
        "cities": {"type": "array", "minItems": 1, "uniqueItems": true,
                   "items": {"type": "string", "pattern": "^[A-Z][A-Za-z' ]+$"}}
      }
    },
    "issuers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "group", "kind", "issuer_type", "source_url", "source_title", "basis"],
        "anyOf": [{"required": ["names"]}, {"required": ["patterns"]}],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "group": {"enum": ["A", "S", "H"]},
          "kind": {"enum": ["central_state_media", "international_communication_centre", "publicity_department",
                            "party_committee", "government", "party_daily", "state_owned_enterprise",
                            "state_institution", "sar_body"]},
          "issuer_type": {"enum": ["state_media", "government", "party", "diplomatic", "state_owned_enterprise",
                                   "sar_government"]},
          "names": {"type": "array", "minItems": 1, "uniqueItems": true,
                    "items": {"type": "string", "minLength": 3, "maxLength": 120}},
          "patterns": {"type": "array", "minItems": 1, "uniqueItems": true,
                       "items": {"type": "string", "minLength": 10, "maxLength": 600}},
          "domains": {"type": "array", "uniqueItems": true,
                      "items": {"type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"}},
          "china_dateline": {"type": "boolean"},
          "source_url": {"type": "string", "pattern": "^https?://[^\\s]+\\.[^\\s]+$"},
          "source_title": {"type": "string", "minLength": 5, "maxLength": 200},
          "basis": {"type": "string", "minLength": 20, "maxLength": 400}
        }
      }
    }
  }
}
