{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourced news context for the unusual days",
  "type": "object",
  "required": ["window", "spikes"],
  "additionalProperties": false,
  "properties": {
    "window": {
      "type": "object",
      "required": ["days_before", "days_after"],
      "additionalProperties": false,
      "properties": {
        "days_before": {"type": "integer", "minimum": 0, "maximum": 7},
        "days_after": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "spikes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["country", "date", "researched", "notes"],
        "additionalProperties": false,
        "properties": {
          "country": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "researched": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["scope", "event", "event_date", "source_title", "source_url", "confidence", "basis"],
                  "additionalProperties": false,
                  "properties": {
                    "scope": {"enum": ["country", "bilateral", "china", "world"]},
                    "event": {"type": "string", "minLength": 20, "maxLength": 300},
                    "event_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                    "event_end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                    "source_title": {"type": "string", "minLength": 5, "maxLength": 200},
                    "source_url": {"type": "string", "pattern": "^https://[^\\s]+\\.[^\\s]+$"},
                    "confidence": {"enum": ["confirmed", "plausible"]},
                    "basis": {"type": "string", "minLength": 10, "maxLength": 400}
                  }
                },
                {
                  "type": "object",
                  "required": ["scope", "result", "searched"],
                  "additionalProperties": false,
                  "properties": {
                    "scope": {"enum": ["country", "bilateral", "china", "world"]},
                    "result": {"const": "no matching event found"},
                    "searched": {"type": "string", "minLength": 10, "maxLength": 400},
                    "note": {"type": "string", "minLength": 10, "maxLength": 400}
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
